# ══════════════════════════════════════════════════════════════════
# Soter Incident Manager — Backend Environment Variables
# ══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in every value marked REQUIRED.
# Never commit .env to version control.
# ══════════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development
# Production value: NODE_ENV=production  (must be set in Render)

# ── MongoDB (REQUIRED) ───────────────────────────────────────────
# Production database — the app reads this when NODE_ENV != test.
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=REPLACE_WITH_YOUR_PRODUCTION_MONGODB_URI

# Test database — used ONLY when NODE_ENV=test (npm test).
# MUST point to a DIFFERENT database from MONGODB_URI.
# The server refuses to start in test mode if this equals MONGODB_URI.
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/soter_test?retryWrites=true&w=majority
TEST_MONGODB_URI=REPLACE_WITH_A_SEPARATE_TEST_ONLY_MONGODB_URI

# ── JWT (REQUIRED) ───────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET_AT_LEAST_64_CHARS
JWT_EXPIRES_IN=7d

# ── CORS (REQUIRED in production) ────────────────────────────────
# Comma-separated list of allowed frontend origins. No wildcards.
# Local dev:   http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500
# Production:  https://your-frontend.onrender.com
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500

# ── Platform superadmin seed credentials ─────────────────────────
# Used ONLY on first run to seed the initial platform_superadmin if none exists.
# After first run: rotate immediately via POST /api/auth/rotate-admin-password.
# Choose a strong, unique password — do NOT use admin123 or any default value.
PLATFORM_ADMIN_EMAIL=admin@your-domain.com
PLATFORM_ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD_MIN_12_CHARS
PLATFORM_ADMIN_NAME=Platform Admin

# ══════════════════════════════════════════════════════════════════
# Production Render Environment Variable Checklist
# ══════════════════════════════════════════════════════════════════
# Set all of the following in the Render dashboard before first deploy:
#
#   MONGODB_URI          → your Atlas production connection string
#   JWT_SECRET           → 64+ char random hex string
#   CORS_ORIGIN          → https://your-frontend.onrender.com
#   NODE_ENV             → production
#   PLATFORM_ADMIN_EMAIL → your admin email
#   PLATFORM_ADMIN_PASSWORD → strong unique password (rotate after first boot)
#
# DO NOT set TEST_MONGODB_URI on Render — it is only needed locally.
# ══════════════════════════════════════════════════════════════════
